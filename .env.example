# Server Configuration
NODE_ENV=development
PORT=8080
# MCP Protocol: All logs write to stderr (stdout reserved for JSON-RPC)
LOG_LEVEL=info

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Workload Identity Federation
WORKLOAD_IDENTITY_POOL_ID=mcp-bigquery-pool-dev
WORKLOAD_IDENTITY_PROVIDER_ID=google-workspace-dev
MCP_SERVICE_ACCOUNT_EMAIL=mcp-bigquery-server-dev@your-project.iam.gserviceaccount.com

# Google Workspace
GOOGLE_WORKSPACE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
GOOGLE_WORKSPACE_DOMAIN=your-company.com
GOOGLE_WORKSPACE_ALLOWED_GROUPS=data-engineers,analysts

# BigQuery
BIGQUERY_LOCATION=US
BIGQUERY_MAX_RETRIES=3
BIGQUERY_TIMEOUT=60000

# Security
ENABLE_CORS=true
ALLOWED_ORIGINS=https://console.cloud.google.com,http://localhost:3000
MAX_QUERY_SIZE_BYTES=10485760

# Monitoring
ENABLE_METRICS=true
ENABLE_TRACING=false
