{
  "name": "gcp-bigquery-mcp-server",
  "version": "1.0.0",
  "description": "GCP BigQuery MCP Server with Workload Identity Federation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs tests/integration",
    "test:performance": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs tests/performance",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t mcp-bigquery-server .",
    "docker:run": "docker run -p 8080:8080 mcp-bigquery-server"
  },
  "keywords": [
    "mcp",
    "bigquery",
    "gcp",
    "workload-identity-federation",
    "claude",
    "ai"
  ],
  "author": "Hive Mind Collective",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1",
    "@google-cloud/opentelemetry-cloud-monitoring-exporter": "^0.21.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.6.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-prometheus": "^0.214.0",
    "@opentelemetry/instrumentation": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@ruvector/rvf": "^0.2.1",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "jose": "^6.2.2",
    "winston": "^3.19.0",
    "yaml": "^2.8.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
