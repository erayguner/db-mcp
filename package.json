{
  "name": "gcp-bigquery-mcp-server",
  "version": "1.0.0",
  "description": "GCP BigQuery MCP Server with Workload Identity Federation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs tests/integration",
    "test:performance": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs tests/performance",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t mcp-bigquery-server .",
    "docker:run": "docker run -p 8080:8080 mcp-bigquery-server"
  },
  "keywords": [
    "mcp",
    "bigquery",
    "gcp",
    "workload-identity-federation",
    "claude",
    "ai"
  ],
  "author": "Hive Mind Collective",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1",
    "@google-cloud/opentelemetry-cloud-monitoring-exporter": "^0.18.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^2.3.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.49.1",
    "@opentelemetry/instrumentation": "^0.52.1",
    "@opentelemetry/resources": "^1.25.1",
    "@opentelemetry/sdk-metrics": "^1.25.1",
    "@opentelemetry/sdk-trace-base": "^1.25.1",
    "@opentelemetry/sdk-trace-node": "^1.25.1",
    "@opentelemetry/semantic-conventions": "^1.25.1",
    "@ruvector/rvf": "^0.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "google-auth-library": "^9.6.3",
    "winston": "^3.11.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
