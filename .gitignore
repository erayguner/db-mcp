.env.development.local
.env.test.local
benchmark-results/
*.bench
debug/
.debug/
config.local.js
config.local.json
config.local.yaml
config.local.yml
deployment-artifacts/
test-data/local/
fixtures/local/
*.cpuprofile
*.heapprofile
*.heapsnapshot

# ============================================
# Keep These Files (Whitelist)
# ============================================

!docs/**/*.md
!README.md
!CHANGELOG.md
!LICENSE
!.env.example
!.env.template
!terraform.tfvars.example
!config.example.json
!config.example.yaml
!docker-compose.example.yml
!scripts/*.sh
!.github/workflows/*.yml
!.github/workflows/*.yaml
!tests/fixtures/**/*
!tests/data/**/*
!memory/sessions/README.md
!memory/agents/README.md
