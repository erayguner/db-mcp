src/**/*.backup

# Script backups
scripts/*.backup

# ============================================
# Package and Lock Files
# ============================================

# Keep package-lock.json for reproducible builds
# package-lock.json can be committed
# But some teams prefer to ignore it
# Uncomment the line below if your team ignores it:
# package-lock.json

